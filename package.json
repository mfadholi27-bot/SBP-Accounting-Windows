{
  "name": "sbp-accounting-v19-desktop",
  "version": "19.0.0",
  "description": "SBP Accounting V19 desktop wrapper - original V19 accounting core",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:x86": "electron-builder --win nsis --ia32 --publish never",
    "dist:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:all": "electron-builder --win nsis --ia32 --x64 --publish never"
  },
  "devDependencies": { "electron": "22.3.27", "electron-builder": "23.6.0" },
  "build": {
    "appId": "id.sbp.accounting.v19",
    "productName": "SBP Accounting V19",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["electron/**/*", "src/v19/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["ia32", "x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "perMachine": false }
  }
}